# Build output
/out/
/build/
CMakeUserPresets.json

# Build directories created outside /out/ (per-stage trees use names like b457_perf)
b*_perf/
cmake-build-*/

# Binary build artifacts, wherever they land
*.exe
*.dll
*.lib
*.obj
*.exp
*.iobj
*.ipdb
*.res
*.tlog

# Copyrighted game data.  Never publish: the PSP executable, its decrypted ELF
# and save data are the user's own dumped media, not part of this source tree.
PSP_DATA/
SAVEDATA/
*.ELF
*.elf
*.iso
*.cso

# User-owned game data and reverse-engineering workspace
/profiles/*/game/
/profiles/*/analysis/
/profiles/*/progress/
/profiles/*/captures/

# Generated scratch output (the checked-in profile corpus is not ignored)
*.generated
*.tmp
*.log
*.pdb
*.ilk

# IDE files
.vs/
.vscode/
.idea/
*.user
*.suo

# Python
__pycache__/
*.pyc

# ---- Persona 1 profile: nothing derived from the game goes in the repo ----
# Generated (recompiled) game code is rebuilt locally from your own dump.
/persona1/gen*/
/profiles/persona1/generated/*
!/profiles/persona1/generated/.gitkeep
# Analyzer output and function lists made from your own EBOOT
/persona1/report*.csv
/persona1/report*.json
/persona1/functions_*.csv
/persona1/nids_persona1.csv
/persona1/cheat*.txt
# Your dumped game, texture packs, saves, logs and screenshots
/persona1/game/
/persona1/mods/
/persona1/ms0/
/Persona_Project_Philemon/*
!/Persona_Project_Philemon/*.bat
!/Persona_Project_Philemon/README.txt
!/Persona_Project_Philemon/game/
/Persona_Project_Philemon/game/*
!/Persona_Project_Philemon/game/.gitkeep
!/Persona_Project_Philemon/mods/
/Persona_Project_Philemon/mods/*
!/Persona_Project_Philemon/mods/.gitkeep
EBOOT.BIN
*.pmf
*.bak
*.bmp
persona1_screenshot_*.png
tex_*_swz*.png
